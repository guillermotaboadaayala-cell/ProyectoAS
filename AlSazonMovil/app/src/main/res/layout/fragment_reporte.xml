<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_cristal_rojo"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORTES Y ESTADÍSTICAS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="12dp" />

        <!-- Grafica Comparativa sencilla con barras nativas (Verde vs Rojo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#33000000"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRÁFICA COMPARATIVA: VENTAS VS GASTOS"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvLabelVerde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VENTAS / INGRESOS (VERDE): $0.00"
                android:textColor="#81C784"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/barraVerdeVentas"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:max="100"
                android:progress="70"
                android:progressTint="#28A745"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLabelRojo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GASTOS + RETIROS (ROJO): $0.00"
                android:textColor="#FF8A80"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/barraRojaGastos"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:max="100"
                android:progress="45"
                android:progressTint="#DC3545" />
        </LinearLayout>

        <!-- Datos de Cortes y Reporte General -->
        <TextView
            android:id="@+id/tvResumenCorte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando estadísticas..."
            android:textColor="#FFFFFF"
            android:fontFamily="serif"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:background="#22000000" />

    </LinearLayout>
</ScrollView>