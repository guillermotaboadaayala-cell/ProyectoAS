<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/panel_cristal_rojo">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONSULTA DE VENTAS"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FILTRAR HISTORIAL CON SPINNER:"
        android:textColor="#FFCC80"
        android:fontFamily="serif"
        android:textSize="13sp" />

    <!-- Spinner visto en el 2do Parcial -->
    <Spinner
        android:id="@+id/spFiltroVentas"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#55FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvTotalVentasConsulta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TOTAL ACUMULADO DE VENTAS: $0.00"
        android:textColor="#FFE082"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/lvVentas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#44FFFFFF"
        android:dividerHeight="1dp"
        android:background="#22000000" />
</LinearLayout>